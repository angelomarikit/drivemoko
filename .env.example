# Copy to .env.local for local development (do not commit secrets)

# mock = existing Zustand demo (default today)
# supabase = production data provider (after Phase 2–3 implementation)
VITE_DATA_PROVIDER=supabase

# Supabase (required when VITE_DATA_PROVIDER=supabase)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional — only set to "configured" when SMS edge function + provider secrets are live (never put API keys in VITE_*).
# VITE_SMS_STATUS=not_configured

# Optional — production site origin for Auth emails (must match Supabase Site URL when set)
# VITE_PUBLIC_SITE_URL=https://YOUR_DOMAIN

# Supabase Dashboard → Authentication → URL Configuration:
# Site URL: https://YOUR_DOMAIN  (NOT http://localhost:3000 unless you dev on that port)
# Redirect URLs (allow list):
# - https://YOUR_DOMAIN/auth/callback
# - https://YOUR_DOMAIN/auth/reset-password
# - http://localhost:5173/auth/callback
# - http://localhost:5173/auth/reset-password